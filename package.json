  "author": "Ridwan Shamoun",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
