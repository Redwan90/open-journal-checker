{
  "name": "open-journal-checker",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Configurable open-source manuscript submission readiness checker for scholarly journals",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
